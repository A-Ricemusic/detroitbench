{
  "name": "detroitbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/prepare.mjs && bun --bun vite --host 127.0.0.1",
    "build": "bun scripts/prepare.mjs && bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "test": "bun test ./tests",
    "bench": "bun benchmark/cli.mjs",
    "bench:demo": "bun benchmark/cli.mjs --provider mock --model simulated-baseline --repeats 3 --out runs/demo.json",
    "bench:publish": "bun scripts/publish.mjs",
    "check": "bun scripts/validate.mjs",
    "atlas:build": "bun scripts/atlas-embed.mjs",
    "atlas:assemble": "bun scripts/atlas-assemble.mjs",
    "story:assemble": "bun scripts/story-assemble.mjs",
    "story:counts": "bun scripts/story-counts.mjs",
    "dataset:assemble": "bun scripts/dataset-assemble.mjs",
    "play": "bun benchmark/play.mjs",
    "play:report": "bun scripts/run-report.mjs",
    "play:model": "bun benchmark/story-provider.mjs",
    "play:checklist": "bun scripts/play-checklist.mjs",
    "experience": "bun benchmark/experience.mjs",
    "share": "bun scripts/prepare.mjs && bun --bun vite build && bun --bun vite preview --host \"$(/Applications/Tailscale.app/Contents/MacOS/Tailscale ip -4 2>/dev/null || tailscale ip -4)\" --port 4173 --strictPort"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.2.0"
  },
  "packageManager": "bun@1.3.14"
}
